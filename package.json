{
  "name": "manim-motion-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"services/**/*.{js,ts,vue,json,css}\" \"packages/**/*.{js,ts,json}\" \"e2e/**/*.{js,ts,json}\"",
    "format:check": "prettier --check \"services/**/*.{js,ts,vue,json,css}\" \"packages/**/*.{js,ts,json}\" \"e2e/**/*.{js,ts,json}\"",
    "typecheck": "npm run build:codegen && vue-tsc -p services/web/tsconfig.json --noEmit && tsc -p services/api/tsconfig.json --noEmit",
    "build:codegen": "tsc -p packages/manim-codegen/tsconfig.json"
  },
  "workspaces": [
    "packages/*",
    "services/api",
    "services/web"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.42",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vue-tsc": "^2.2.12"
  }
}
