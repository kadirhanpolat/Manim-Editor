exports[`PropertiesPanel characterization — object branch > renders identically for double_arrow 1`] = `"<aside class="w-72 bg-studio-surface border-l border-studio-border flex flex-col flex-shrink-0 overflow-y-auto"> <div class="panel-header flex items-center justify-between"> Properties <span class="px-1.5 py-0.5 text-[9px] rounded-md font-bold uppercase bg-gray-600 text-white">double_arrow</span></div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Name</label><input class="input input-sm" value="Double Arrow 1"></div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Position &amp; Size</label> <div class="grid grid-cols-2 gap-1.5"> <div><span class="text-[9px] text-studio-text-muted/50">X</span><input class="input input-sm" type="number" step="1" value="960"></div> <div><span class="text-[9px] text-studio-text-muted/50">Y</span><input class="input input-sm" type="number" step="1" value="540"></div> <div><span class="text-[9px] text-studio-text-muted/50">Width</span><input class="input input-sm" type="number" min="1" step="1" value="200"></div> <div><span class="text-[9px] text-studio-text-muted/50">Height</span><input class="input input-sm" type="number" min="1" step="1" value="40"></div> </div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Align to Canvas</label> <div class="anchor-grid"> <div class="flex gap-1"><button class="anchor-btn" title="TOP LEFT">↖</button><button class="anchor-btn" title="TOP">↑</button><button class="anchor-btn" title="TOP RIGHT">↗</button></div> <div class="flex gap-1"><button class="anchor-btn" title="LEFT">←</button><button class="anchor-btn" title="CENTER">●</button><button class="anchor-btn" title="RIGHT">→</button></div> <div class="flex gap-1"><button class="anchor-btn" title="BOTTOM LEFT">↙</button><button class="anchor-btn" title="BOTTOM">↓</button><button class="anchor-btn" title="BOTTOM RIGHT">↘</button></div> </div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Rotation</label> <div class="flex items-center gap-2"><input class="input input-sm flex-1" type="number" value="0"><span class="text-[10px] text-studio-text-muted">deg</span></div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Colors</label> <div class="space-y-1.5"> <div class="flex items-center gap-2"><span class="text-[10px] text-studio-text-muted w-12">Fill</span><input type="color" class="color-input" value="#ef4444"><input class="input input-sm flex-1" value="#ef4444"></div> <div class="flex items-center gap-2"><span class="text-[10px] text-studio-text-muted w-12">Stroke</span><input type="color" class="color-input" value="#fff"><input class="input input-sm flex-1" value="#fff"></div> <div class="flex items-center gap-2"><span class="text-[10px] text-studio-text-muted w-12">Stroke W</span><input class="input input-sm w-16" type="number" min="0" step="0.5" value="2"></div> </div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Opacity</label> <div class="flex items-center gap-2"><input type="range" min="0" max="1" step="0.01" class="flex-1 accent-studio-accent" value="1"><span class="text-[10px] text-studio-text-muted w-8 text-right tabular-nums">100%</span></div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Effects</label> <div class="space-y-2"> <div><button class="flex items-center justify-between w-full text-[10px] text-studio-text-muted"><span>Dashed stroke</span><span class="">Off</span></button> </div> </div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Timeline</label> <div class="grid grid-cols-2 gap-1.5"> <div><span class="text-[9px] text-studio-text-muted/50">Enter (s)</span><input class="input input-sm" type="number" min="0" step="0.1" value="0"></div> <div><span class="text-[9px] text-studio-text-muted/50">Duration (s)</span><input class="input input-sm" type="number" min="0.1" step="0.1" value="3"></div> </div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Layer Order</label><input class="input input-sm w-16" type="number" min="0" value="0"></div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Entrance</label> <div class="space-y-1.5"><select class="select text-xs" value="fade_in"> <option value="none">— None</option> <option value="fade_in">◐ Fade In</option> <option value="grow_in">⊕ Grow In</option> <option value="fly_in_left">→ Fly In Left</option> <option value="fly_in_right">← Fly In Right</option> <option value="fly_in_top">↓ Fly In Top</option> <option value="fly_in_bottom">↑ Fly In Bottom</option> <option value="draw">✎ Draw / Create</option> <option value="write">✍ Write</option> <option value="spin_in">↻ Spin In</option> <option value="bounce_in">⤴ Bounce In</option> <option value="typewriter">⌨ Typewriter</option> </select> <div class="flex items-center gap-2"><span class="text-[9px] text-studio-text-muted w-14">Duration</span><input class="input input-sm w-16" type="number" min="0.1" max="5" step="0.1" value="0.5"><span class="text-[9px] text-studio-text-muted">s</span></div> <p class="text-[8px] text-studio-text-muted/40 leading-snug">Fade from transparent</p> </div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Exit</label> <div class="space-y-1.5"><select class="select text-xs" value="fade_out"> <option value="none">— None</option> <option value="fade_out">◑ Fade Out</option> <option value="shrink_out">⊖ Shrink Out</option> <option value="fly_out_left">← Fly Out Left</option> <option value="fly_out_right">→ Fly Out Right</option> <option value="fly_out_top">↑ Fly Out Top</option> <option value="fly_out_bottom">↓ Fly Out Bottom</option> <option value="uncreate">✎ Uncreate</option> <option value="spin_out">↻ Spin Out</option> <option value="typewriter_out">⌨ Typewriter Out</option> </select> <div class="flex items-center gap-2"><span class="text-[9px] text-studio-text-muted w-14">Duration</span><input class="input input-sm w-16" type="number" min="0.1" max="5" step="0.1" value="0.5"><span class="text-[9px] text-studio-text-muted">s</span></div> <p class="text-[8px] text-studio-text-muted/40 leading-snug">Fade to transparent</p> </div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Add Motion</label> <p class="text-[8px] text-studio-text-muted/50 mb-1.5">Create a timeline clip animation</p> <div class="grid grid-cols-2 gap-1"><button class="anim-btn move"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"> <path d="M5 12h14M12 5l7 7-7 7"></path> </svg> Move </button><button class="anim-btn scale"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"> <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path> </svg> Scale </button><button class="anim-btn fade"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"> <circle cx="12" cy="12" r="10" opacity="0.5"></circle> </svg> Fade </button><button class="anim-btn rotate"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"> <path d="M1 4v6h6M3.51 15a9 9 0 1014.85-3.36L23 8"></path> </svg> Rotate </button></div> <p class="text-[8px] text-studio-text-muted/50 mb-1.5 mt-2">Emphasis (transient)</p> <div class="grid grid-cols-2 gap-1"><button data-test="anim-indicate" class="anim-btn emph">Indicate</button><button data-test="anim-flash" class="anim-btn emph">Flash</button><button data-test="anim-wiggle" class="anim-btn emph">Wiggle</button><button data-test="anim-circumscribe" class="anim-btn emph">Circumscribe</button><button data-test="anim-focus_on" class="anim-btn emph">Focus On</button></div> </div> <div class="px-3 py-3 mt-auto"><button class="btn btn-danger btn-xs w-full">Delete Object</button></div> </aside>"`;

