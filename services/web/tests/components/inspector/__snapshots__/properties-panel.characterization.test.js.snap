-2"><span class="text-[9px] text-studio-text-muted w-14">Duration</span><input class="input input-sm w-16" type="number" min="0.1" max="5" step="0.1" value="0.5"><span class="text-[9px] text-studio-text-muted">s</span></div> <p class="text-[8px] text-studio-text-muted/40 leading-snug">Fade from transparent</p> </div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Exit</label> <div class="space-y-1.5"><select class="select text-xs" value="fade_out"> <option value="none">— None</option> <option value="fade_out">◑ Fade Out</option> <option value="shrink_out">⊖ Shrink Out</option> <option value="fly_out_left">← Fly Out Left</option> <option value="fly_out_right">→ Fly Out Right</option> <option value="fly_out_top">↑ Fly Out Top</option> <option value="fly_out_bottom">↓ Fly Out Bottom</option> <option value="uncreate">✎ Uncreate</option> <option value="spin_out">↻ Spin Out</option> <option value="typewriter_out">⌨ Typewriter Out</option> </select> <div class="flex items-center gap-2"><span class="text-[9px] text-studio-text-muted w-14">Duration</span><input class="input input-sm w-16" type="number" min="0.1" max="5" step="0.1" value="0.5"><span class="text-[9px] text-studio-text-muted">s</span></div> <p class="text-[8px] text-studio-text-muted/40 leading-snug">Fade to transparent</p> </div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Add Motion</label> <p class="text-[8px] text-studio-text-muted/50 mb-1.5">Create a timeline clip animation</p> <div class="grid grid-cols-2 gap-1"><button class="anim-btn move"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"> <path d="M5 12h14M12 5l7 7-7 7"></path> </svg> Move </button><button class="anim-btn scale"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"> <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path> </svg> Scale </button><button class="anim-btn fade"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"> <circle cx="12" cy="12" r="10" opacity="0.5"></circle> </svg> Fade </button><button class="anim-btn rotate"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"> <path d="M1 4v6h6M3.51 15a9 9 0 1014.85-3.36L23 8"></path> </svg> Rotate </button></div> <p class="text-[8px] text-studio-text-muted/50 mb-1.5 mt-2">Emphasis (transient)</p> <div class="grid grid-cols-2 gap-1"><button data-test="anim-indicate" class="anim-btn emph">Indicate</button><button data-test="anim-flash" class="anim-btn emph">Flash</button><button data-test="anim-wiggle" class="anim-btn emph">Wiggle</button><button data-test="anim-circumscribe" class="anim-btn emph">Circumscribe</button><button data-test="anim-focus_on" class="anim-btn emph">Focus On</button></div> </div> <div class="px-3 py-3 mt-auto"><button class="btn btn-danger btn-xs w-full">Delete Object</button></div> </aside>"`;

