v class="flex gap-1"><button class="anchor-btn" title="BOTTOM LEFT">↙</button><button class="anchor-btn" title="BOTTOM">↓</button><button class="anchor-btn" title="BOTTOM RIGHT">↘</button></div> </div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Rotation</label> <div class="flex items-center gap-2"><input class="input input-sm flex-1" type="number" value="0"><span class="text-[10px] text-studio-text-muted">deg</span></div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Colors</label> <div class="space-y-1.5"> <div class="flex items-center gap-2"><span class="text-[10px] text-studio-text-muted w-12">Fill</span><input type="color" class="color-input" value="#ffffff"><input class="input input-sm flex-1" value="#ffffff"></div> <div class="flex items-center gap-2"><span class="text-[10px] text-studio-text-muted w-12">Stroke</span><input type="color" class="color-input" value="#ffffff"><input class="input input-sm flex-1" value="#ffffff"></div> <div class="flex items-center gap-2"><span class="text-[10px] text-studio-text-muted w-12">Stroke W</span><input class="input input-sm w-16" type="number" min="0" step="0.5" value="2"></div> </div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Opacity</label> <div class="flex items-center gap-2"><input type="range" min="0" max="1" step="0.01" class="flex-1 accent-studio-accent" value="1"><span class="text-[10px] text-studio-text-muted w-8 text-right tabular-nums">100%</span></div> </div> <div class="px-3 py-2 border-b border-studio-border/50"><label class="text-[10px] text-studio-text-muted/70 uppercase font-bold tracking-wider mb-1 block">Timeline</label> <div class="grid grid-cols-2 gap-