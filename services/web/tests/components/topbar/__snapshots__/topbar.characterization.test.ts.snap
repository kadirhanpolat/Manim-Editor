exports[`Topbar characterization > new project dialog open 1`] = `"<div class="menubar-root"> <header class="menubar-header" aria-label="Application toolbar"> <div class="menubar-brand"><img src="/ManimMotionLogoNoTextNoBG.svg" alt="" class="brand-logo" width="24" height="24"><span class="brand-name">Manim</span><span class="brand-sub">Motion</span></div> <nav class="menubar-nav" role="menubar"> <div class="menu-anchor"><button class="menu-label" tabindex="0" role="menuitem" aria-haspopup="true" aria-expanded="false">File</button> <transition-stub name="menu-pop" appear="false" persisted="false" css="true"> </transition-stub> </div> <div class="menu-anchor"><button class="menu-label" tabindex="0" role="menuitem" aria-haspopup="true" aria-expanded="false">Edit</button> <transition-stub name="menu-pop" appear="false" persisted="false" css="true"> </transition-stub> </div> <div class="menu-anchor"><button class="menu-label" tabindex="0" role="menuitem" aria-haspopup="true" aria-expanded="false">View</button> <transition-stub name="menu-pop" appear="false" persisted="false" css="true"> </transition-stub> </div> <div class="menu-anchor"><button class="menu-label" tabindex="0" role="menuitem" aria-haspopup="true" aria-expanded="false">Tools</button> <transition-stub name="menu-pop" appear="false" persisted="false" css="true"> </transition-stub> </div> <div class="menu-anchor"><button class="menu-label" tabindex="0" role="menuitem" aria-haspopup="true" aria-expanded="false">Help</button> <transition-stub name="menu-pop" appear="false" persisted="false" css="true"> </transition-stub> </div> </nav> <div class="menubar-center"><span class="tb-title-label">title:</span><input class="tb-project-input" placeholder="Project name" title="Project name" aria-label="Project name" value="Char"> </div> <div class="menubar-spacer"></div> <div class="menubar-right"> <div class="tb-divider"></div><button class="tb-toggle tb-scene-type" title="Toggle 2D/3D scene mode">2D</button><button class="tb-toggle" title="Toggle Moving Camera (MovingCameraScene)" aria-label="Toggle Moving Camera (MovingCameraScene)"> 🎥 </button><button class="tb-toggle on" title="Grid" aria-label="Grid"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"> <rect x="3" y="3" width="18" height="18"></rect> <line x1="3" y1="9" x2="21" y2="9"></line> <line x1="3" y1="15" x2="21" y2="15"></line> <line x1="9" y1="3" x2="9" y2="21"></line> <line x1="15" y1="3" x2="15" y2="21"></line> </svg></button><button class="tb-toggle on" title="Snap" aria-label="Snap"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"> <path d="M21 3L3 21"></path> <path d="M21 3v7h-7"></path> </svg></button><span class="tb-dim">1920×1080</span><button class="tb-render-btn" title="Render HQ via Docker"><svg class="tb-play-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"> <path d="M8 5v14l11-7z"></path> </svg><span class="tb-render-label">Render</span></button> </div> </header> <transition-stub name="menu-pop" appear="false" persisted="false" css="true"> <div class="np-overlay"> <div class="np-dialog" role="dialog" aria-modal="true" aria-labelledby="np-dialog-title"> <h2 id="np-dialog-title" class="np-title">New Project</h2><label class="np-label">Project Name</label><input class="np-input" placeholder="My Animation"><label class="np-label" style="margin-top: 12px;">Editor Mode</label> <div class="np-mode-row"><button class="np-mode-btn active"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"> <rect x="3" y="3" width="18" height="18" rx="2"></rect> <line x1="3" y1="9" x2="21" y2="9"></line> </svg><span class="np-mode-label">Visual (UI)</span><span class="np-mode-desc">Drag-and-drop canvas, timeline, shapes</span></button><button class="np-mode-btn"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"> <polyline points="16 18 22 12 16 6"></polyline> <polyline points="8 6 2 12 8 18"></polyline> </svg><span class="np-mode-label">Code Only</span><span class="np-mode-desc">Full Manim power, write Python directly</span></button></div><label class="np-label" style="margin-top: 12px;">Template</label> <div class="np-cat-chips"><button class="np-cat-chip active">All</button><button class="np-cat-chip">General</button><button class="np-cat-chip">Calculus</button><button class="np-cat-chip">Linear Algebra</button><button class="np-cat-chip">Trigonometry</button><button class="np-cat-chip">Statistics</button><button class="np-cat-chip">Programming</button></div> <div class="np-tpl-grid"><button class="np-mode-btn active" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">□</span><span class="np-mode-label">Blank Project</span><span class="np-mode-desc">Start from scratch</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">∑</span><span class="np-mode-label">Formula Reveal</span><span class="np-mode-desc">Reveal a LaTeX formula with a writing effect</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">⇌</span><span class="np-mode-label">Shape Transform</span><span class="np-mode-desc">Morph one shape into another</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">T</span><span class="np-mode-label">Title Slide</span><span class="np-mode-desc">Title and subtitle fade in sequentially</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">⊕</span><span class="np-mode-label">Coordinate System</span><span class="np-mode-desc">Axes are drawn onto the stage</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">lim</span><span class="np-mode-label">Limit Approach</span><span class="np-mode-desc">Visualize the limit concept as x approaches c</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">∂</span><span class="np-mode-label">Derivative Tangent</span><span class="np-mode-desc">Show the derivative and tangent line at a point</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">∫</span><span class="np-mode-label">Integral Area</span><span class="np-mode-desc">Show a definite integral and Riemann area</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">→</span><span class="np-mode-label">Vector Addition</span><span class="np-mode-desc">Show the resultant sum of two vectors</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">⊗</span><span class="np-mode-label">Matrix Multiplication</span><span class="np-mode-desc">Multiply two 2×2 matrices</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">○</span><span class="np-mode-label">Unit Circle</span><span class="np-mode-desc">Trigonometric unit circle with sin/cos display</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">∿</span><span class="np-mode-label">Sine &amp; Cosine Graph</span><span class="np-mode-desc">Compare the sine and cosine waves</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">⌒</span><span class="np-mode-label">Normal Distribution</span><span class="np-mode-desc">Gaussian bell curve with the ±1σ region</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">∎</span><span class="np-mode-label">Theorem Proof</span><span class="np-mode-desc">Theorem statement, proof steps, and conclusion</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">⚙</span><span class="np-mode-label">Algorithm Steps</span><span class="np-mode-desc">Three-step flowchart: Start → Process → End</span></button></div> <div class="np-actions"><button class="np-btn np-btn-cancel">Cancel</button><button class="np-btn np-btn-create">Create Project</button></div> </div> </div> </transition-stub> <transition-stub name="menu-pop" appear="false" persisted="false" css="true"> </transition-stub> </div>"`;
