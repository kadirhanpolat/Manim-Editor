ene)"> 🎥 </button><button class="tb-toggle on" title="Grid"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"> <rect x="3" y="3" width="18" height="18"></rect> <line x1="3" y1="9" x2="21" y2="9"></line> <line x1="3" y1="15" x2="21" y2="15"></line> <line x1="9" y1="3" x2="9" y2="21"></line> <line x1="15" y1="3" x2="15" y2="21"></line> </svg></button><button class="tb-toggle on" title="Snap"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"> <path d="M21 3L3 21"></path> <path d="M21 3v7h-7"></path> </svg></button><span class="tb-dim">1920×1080</span><button class="tb-render-btn" title="Render HQ via Docker"><svg class="tb-play-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"> <path d="M8 5v14l11-7z"></path> </svg><span class="tb-render-label">Render</span></button> </div> </header> <transition-stub name="menu-pop" appear="false" persisted="false" css="true"> <div class="np-overlay"> <div class="np-dialog"> <h2 class="np-title">New Project</h2><label class="np-label">Project Name</label><input class="np-input" placeholder="My Animation"><label class="np-label" style="margin-top: 12px;">Editor Mode</label> <div class="np-mode-row"><button class="np-mode-btn active"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"> <rect x="3" y="3" width="18" height="18" rx="2"></rect> <line x1="3" y1="9" x2="21" y2="9"></line> </svg><span class="np-mode-label">Visual (UI)</span><span class="np-mode-desc">Drag-and-drop canvas, timeline, shapes</span></button><button class="np-mode-btn"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"> <polyline points="16 18 22 12 16 6"></polyline> <polyline points="8 6 2 12 8 18"></polyline> </svg><span class="np-mode-label">Code Only</span><span class="np-mode-desc">Full Manim power, write Python directly</span></button></div><label class="np-label" style="margin-top: 12px;">Şablon</label> <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 4px;"><button class="np-mode-btn active" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">□</span><span class="np-mode-label">Boş Proje</span><span class="np-mode-desc">Sıfırdan başla</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">∑</span><span class="np-mode-label">Formül Tanıtım</span><span class="np-mode-desc">LaTeX formülü yazma efektiyle ortaya çıkar</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">⇌</span><span class="np-mode-label">Şekil Dönüşümü</span><span class="np-mode-desc">Bir şekil diğerine morph olur</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">T</span><span class="np-mode-label">Başlık Slaydı</span><span class="np-mode-desc">Başlık ve alt başlık kademeli giriş</span></button><button class="np-mode-btn" style="text-align: left; padding: 10px 12px;"><span style="font-size: 18px; display: block; margin-bottom: 4px;">⊕</span><span class="np-mode-label">Koordinat Sistemi</span><span class="np-mode-desc">Eksenler sahneye çizilir</span></button></div> <div class="np-actions"><button class="np-btn np-btn-cancel">Cancel</button><button class="np-btn np-btn-create">Create Project</button></div> </div> </div> </transition-stub> </div>"`;
