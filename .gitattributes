# Normalize line endings: store LF in the repo and check out LF on every
# platform (Windows included). This keeps Prettier's `endOfLine: lf` happy and
# prevents spurious CRLF diffs / snapshot churn for Windows contributors.
* text=auto eol=lf

# Explicit binary types (never normalize / never diff as text)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  text eol=lf
*.mp4  binary
*.mov  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
